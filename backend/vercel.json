{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel-entry.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/health/(.*)", "dest": "src/vercel-entry.ts" },
    { "src": "/(.*)", "dest": "src/vercel-entry.ts" }
  ],
  "functions": {
    "src/vercel-entry.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["fra1"]
}
