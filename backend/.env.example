# ═══════════════════════════════════════════════════════
# NEXUS Enterprise — Environment Configuration
# ═══════════════════════════════════════════════════════

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ── Database ──
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@localhost:5432/nexus?schema=public"

# ── Security (min 32 chars, ENCRYPTION_KEY = 64 hex) ──
JWT_SECRET=change_me_to_32_chars_minimum_secret_key_xxxxxxxxxx
REFRESH_TOKEN_SECRET=change_me_to_32_chars_minimum_refresh_key_yyyyyyy
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ── Install Lock ──
INSTALL_LOCKED=false
INSTALL_KEY=

# ── Optional ──
REDIS_URL=
SENTRY_DSN=
